# FBITS/Wake: não existe token global. O token é informado por empresa em
# Integrações e salvo cifrado em integration_connections (provider=fbits).
# Creator Intelligence: Instagram usa o token Meta de cada empresa (grátis).
YOUTUBE_API_KEY=
APIFY_TOKEN=
APIFY_INSTAGRAM_HASHTAG_ACTOR=apify~instagram-hashtag-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
CREATORS_APIFY_MONTHLY_BUDGET_USD=5
CREATORS_APIFY_ESTIMATED_RUN_USD=0.25
CREATORS_YOUTUBE_DAILY_UNITS=9000
CREATORS_CACHE_HOURS=24
# Central de Automações (WhatsApp oficial da Mugô via MugôZap/CRM + Google Calendar)
# Sem "true", a fila roda inteira em modo simulado (status "simulado"), sem nenhum envio.
AUTOMATIONS_SEND_ENABLED=
# Leitura dos templates na Meta (somente leitura, permissão whatsapp_business_management)
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATES_TOKEN=
# Tarifas para estimar custo na central (R$ por mensagem enviada); a fatura oficial é a da Meta
AUTOMATIONS_COST_UTILITY_BRL=
AUTOMATIONS_COST_MARKETING_BRL=
# Google Calendar corporativo (usa o mesmo GOOGLE_OAUTH_CLIENT_ID/SECRET)
GOOGLE_CALENDAR_REDIRECT_URI=https://api.dados.mugoagencia.com.br/api/automations/google-calendar/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://api.dados.mugoagencia.com.br/api/automations/google-calendar/webhook
MUGO_AGENCY_CLIENT_ID=mugo
MUGO_EMAIL_DOMAIN=
